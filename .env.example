# Example env vars for Jira integration
# Set to 'true' to use real Jira via the server proxy
REACT_APP_USE_JIRA=true
# Backend API base (server) - frontend will prepend this when calling server
REACT_APP_API_URL=http://localhost:4000

# Jira Cloud example
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here

# OR Jira Server example
#JIRA_BASE_URL=https://jira.example.com
#JIRA_USERNAME=your_username
#JIRA_PASSWORD=your_password

PORT=4000
